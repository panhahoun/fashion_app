# Set this to your backend API base URL (FastAPI on port 8000).
# Keep the `/api` suffix.
#
# Android Emulator:
# API_BASE_URL=http://10.0.2.2:8000/api
#
# iOS Simulator / Web:
# API_BASE_URL=http://localhost:8000/api
#
# Real Device (same Wi-Fi as backend machine):
# API_BASE_URL=http://192.168.1.100:8000/api
#
# Production:
# API_BASE_URL=https://fashionapp.api.hpn.world/api

API_BASE_URL=