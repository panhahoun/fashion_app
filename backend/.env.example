# Fashion Store API configuration.
# Copy to .env and adjust. Never commit your real .env.

# Reload uvicorn on code changes (dev only).
DEBUG=true

# Comma-separated allowed CORS origins, e.g.
# CORS_ORIGINS=http://localhost:8080,https://shop.example.com
CORS_ORIGINS=*

# SQLAlchemy database URL.
# Dev default: SQLite file next to run.py
DATABASE_URL=sqlite:///./fashion_store.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:pass@localhost/fashion_store
#
# Production / Render: free web services have an EPHEMERAL disk, so a SQLite
# file is wiped on every spin-down and deploy (accounts vanish). Point
# DATABASE_URL at a managed Postgres instead, e.g. a free Neon/Supabase project:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/fashion_store?sslmode=require
# (psycopg2-binary is already in requirements.txt; "postgres://" URLs from the
#  provider are normalized automatically.)

# JWT signing secret — change this in production.
SECRET_KEY=change-me-to-a-long-random-string

# JWT token lifetime in hours.
TOKEN_EXPIRE_HOURS=24