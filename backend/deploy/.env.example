# Fashion Store API — production config.
# Copy to the server as ~/fashion-api/deploy/.env and edit. Never commit.

# Reload on code change — MUST be false in production.
DEBUG=false

# Comma-separated allowed CORS origins.
# Mobile apps don't send Origin headers, so "*" is fine.
# If you later host Flutter *web*, add its origin, e.g.
# CORS_ORIGINS=https://shop.example.com
CORS_ORIGINS=*

# SQLite file lives INSIDE the container at /app/data (mounted from deploy/data/).
# The absolute path is important — otherwise the db is created in the image and lost.
DATABASE_URL=sqlite:////app/data/fashion_store.db

# JWT signing secret — generate with:  openssl rand -hex 32
# (on your Mac or the server). Never reuse the dev default.
SECRET_KEY=change-me-to-a-long-random-string

# JWT token lifetime in hours.
TOKEN_EXPIRE_HOURS=24